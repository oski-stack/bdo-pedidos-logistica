{
  "mappings": [
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "url": "/api/tarifas",
        "headers": { "Authorization": { "matches": "Bearer .+" } }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
